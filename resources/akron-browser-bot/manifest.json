{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.6.7",
  "description": "__MSG_appDesc__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "tabGroups",
    "alarms",
    "debugger",
    "offscreen",
    "downloads",
    "notifications",
    "contextMenus",
    "declarativeNetRequestWithHostAccess",
    "nativeMessaging",
    "unlimitedStorage"
  ],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/page-hooks.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/agent-overlay.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-side-panel": {
      "description": "__MSG_commandToggle__",
      "suggested_key": {
        "default": "Ctrl+E",
        "mac": "Command+E"
      }
    },
    "focus-side-panel": {
      "description": "Move focus to the Akron side panel"
    },
    "stop-task": {
      "description": "Stop the current Akron task"
    }
  }
}

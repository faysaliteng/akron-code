{
  "name": "akronbot",
  "productName": "Akron Bot",
  "version": "1.0.0",
  "description": "Akron Bot — a free-LLM desktop agent built by AkronLogic",
  "main": "electron/main.js",
  "author": "AkronLogic",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "vendor:runtimes": "node scripts/vendor-runtimes.js",
    "vendor:runtimes:check": "node scripts/vendor-runtimes.js --check",
    "prepack": "npm run vendor:runtimes",
    "pack": "npm run build && electron-builder --dir",
    "predist": "npm run vendor:runtimes",
    "dist": "npm run build && electron-builder --mac dmg zip",
    "freellm": "node scripts/freellm-server.js",
    "icons": "electron build/render_icon.cjs"
  },
  "dependencies": {
    "mermaid": "^10.9.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.1.6",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.akronbot.app",
    "productName": "Akron Bot",
    "copyright": "AkronLogic",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/runtimes",
        "to": "runtimes"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "AkronBot-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Akron Bot ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}

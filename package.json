{
  "name": "akronbot",
  "productName": "Akron Code",
  "version": "1.6.9",
  "description": "Akron Code — multi-agent desktop coding IDE by Akronlogic.com",
  "main": "electron/main.js",
  "bin": {
    "akron": "./bin/akron.js"
  },
  "author": "AkronLogic",
  "homepage": "https://akronlogic.com",
  "license": "SEE LICENSE IN LICENSE.md",
  "scripts": {
    "test": "node --test --test-concurrency=4 test/*.test.js",
    "build": "vite build",
    "typecheck": "node scripts/typecheck.js",
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "eval:security": "node evals/security/run.js",
    "eval:coding": "node evals/coding/run.js",
    "eval:browser": "node evals/browser/run.js",
    "eval:all": "node evals/report.js",
    "brand:seal": "node scripts/seal-brand.js",
    "brand:check": "node -e \"const r=require('./electron/brand-guard').verifyBrandIntegrity();if(!r.ok){console.error(r.problems);process.exit(1);}console.log('BRAND_SEAL_OK',r.checkedFiles);\"",
    "vendor:runtimes": "node scripts/vendor-runtimes.js",
    "vendor:runtimes:check": "node scripts/vendor-runtimes.js --check",
    "vendor:runtimes:sync": "node scripts/vendor-runtimes.js --download --stale",
    "prepack": "npm run vendor:runtimes",
    "pack": "npm run build && electron-builder --dir",
    "predist": "node scripts/vendor-runtimes.js --download --stale || npm run vendor:runtimes",
    "dist": "npm run build && electron-builder --mac dir && node scripts/inject-mac-ext-folder.js",
    "predist:mac": "node scripts/vendor-runtimes.js --download --stale || npm run vendor:runtimes",
    "dist:mac": "npm run build && electron-builder --mac dir && node scripts/inject-mac-ext-folder.js",
    "predist:win": "node scripts/vendor-runtimes.js --download --stale || npm run vendor:runtimes",
    "dist:win": "npm run build && electron-builder --win nsis portable --x64",
    "predist:linux": "node scripts/vendor-runtimes.js --download --stale || npm run vendor:runtimes",
    "dist:linux": "npm run build && electron-builder --linux AppImage tar.gz --x64",
    "freellm": "node scripts/freellm-server.js",
    "icons": "electron build/render_icon.cjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "docx": "^9.16.1",
    "esbuild": "^0.21.5",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "markmap-lib": "^0.18.13",
    "markmap-view": "^0.18.13",
    "mermaid": "^10.9.8",
    "monaco-editor": "^0.58.0",
    "node-pty": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1",
    "sql.js": "^1.17.0",
    "ssh2": "^1.17.0",
    "ws": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.1.6",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.akronbot.app",
    "productName": "Akron Code",
    "copyright": "AkronLogic",
    "asar": true,
    "asarUnpack": [
      "**/electron/ide/pty-worker.js",
      "**/node_modules/node-pty/**/*",
      "**/node_modules/@vscode/ripgrep/**/*",
      "**/node_modules/@vscode/ripgrep-*/**/*",
      "**/node_modules/@parcel/watcher/**/*",
      "**/node_modules/@parcel/watcher-*/**/*",
      "**/node_modules/sql.js/dist/*.wasm",
      "**/node_modules/@ffmpeg-installer/**/*",
      "**/node_modules/@ffprobe-installer/**/*",
      "**/node_modules/esbuild/**/*",
      "**/node_modules/@esbuild/**/*"
    ],
    "compression": "maximum",
    "npmRebuild": false,
    "afterPack": "scripts/harden-fuses.js",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "build/icon.svg",
      "build/logo-mark.svg",
      "build/icon.png",
      "LICENSE.md",
      "TRADEMARKS.md",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "vendor/runtimes",
        "to": "runtimes"
      },
      {
        "from": "resources/akron-browser-bot",
        "to": "akron-browser-bot"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "faysaliteng",
        "repo": "akron-code"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "AkronCode-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Akron Code ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AkronCode-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "AkronCode-${version}-win-setup-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AkronCode-${version}-win-portable-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "maintainer": "AkronLogic <support@akronlogic.com>",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "artifactName": "AkronCode-${version}-linux-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  },
  "optionalDependencies": {
    "@parcel/watcher": "^2.6.0"
  }
}

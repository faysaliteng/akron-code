{
  "name": "akronbot",
  "productName": "Akron Code",
  "version": "1.0.0",
  "description": "Akron Code — multi-agent desktop coding IDE by Akronlogic.com",
  "main": "electron/main.js",
  "author": "AkronLogic",
  "license": "MIT",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "dev": "vite --host 127.0.0.1",
    "vendor:runtimes": "node scripts/vendor-runtimes.js",
    "vendor:runtimes:check": "node scripts/vendor-runtimes.js --check",
    "vendor:runtimes:sync": "node scripts/vendor-runtimes.js --download --stale",
    "prepack": "npm run vendor:runtimes",
    "pack": "npm run build && electron-builder --dir",
    "predist": "node scripts/vendor-runtimes.js --download --stale || npm run vendor:runtimes",
    "dist": "npm run build && electron-builder --mac dmg zip",
    "dist:mac": "npm run build && electron-builder --mac dmg zip",
    "dist:win": "npm run build && electron-builder --win nsis portable",
    "freellm": "node scripts/freellm-server.js",
    "icons": "electron build/render_icon.cjs"
  },
  "dependencies": {
    "mermaid": "^10.9.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.1.6",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.akronbot.app",
    "productName": "Akron Code",
    "copyright": "AkronLogic",
    "asar": true,
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/runtimes",
        "to": "runtimes"
      },
      {
        "from": "resources/akron-browser-bot",
        "to": "akron-browser-bot"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "darkModeSupport": true,
      "icon": "build/icon.icns",
      "identity": null,
      "artifactName": "AkronCode-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Akron Code ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "AkronBot-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
